# Template only. Copy this to `.env.local` for machine-specific values.
# Keep secrets out of `.env.example` and git-tracked files.

# Optional local overrides for runtime artifact resolution
COACH_OUTPUTS_DIR=
COACH_CHECKPOINT_DIR=
COACH_ARTIFACT_ROOT=

# Optional local defaults for cloud runbooks
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=results/gates
REPO_URL=https://github.com/<YOUR_ORG>/<YOUR_REPO>.git
REPO_REF=main
REPO_DIR=<YOUR_REPO>
WORKDIR=/data/sim

# Optional defaults for instance tagging and runtime bundle workflow
INSTANCE_OWNER_TAG=
INSTANCE_ENV_TAG=dev
DATA_VERSION_TAG=
RUNTIME_BUNDLE_S3_URI=
