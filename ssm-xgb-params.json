{"commands": ["#!/bin/bash", "set -euo pipefail", "", "# Write training wrapper script to disk", "cat > /tmp/run-xgb-training.sh << 'WRAPPER_EOF'", "#!/bin/bash", "set -euo pipefail", "exec > /tmp/xgb-training-v2.log 2>&1", "echo \"=== XGBoost training started at $(date -u) ===\"", "", "# Activate DLAMI PyTorch env", "export LD_LIBRARY_PATH=\"${LD_LIBRARY_PATH:-}\"", "source /opt/pytorch/bin/activate", "echo \"Python: $(python3 --version)\"", "", "cd /home/ubuntu/Auto-Battler-Coach-Lab", "", "echo \"=== Starting XGBoost fight training ===\"", "echo \"Start time: $(date -u)\"", "OUTPUT_DIR=\"models/checkpoints/run50k-20260220-064051/xgb_fight\"", "rm -rf \"${OUTPUT_DIR}/.xgb_cache_fight\" 2>/dev/null || true", "mkdir -p \"${OUTPUT_DIR}\"", "python3 -m models.train_xgboost \\", "  --data results/run50k-20260220-064051 \\", "  --task fight \\", "  --output \"${OUTPUT_DIR}\" \\", "  --external-memory \\", "  --n-estimators 300 \\", "  --early-stopping-rounds 50", "echo \"=== XGBoost fight training complete ===\"", "echo \"End time: $(date -u)\"", "", "echo \"Uploading model artifacts to S3...\"", "aws s3 sync \"${OUTPUT_DIR}\" s3://tft-sim-results-forrest/tft-results/models/run50k-20260220-064051/xgb_fight/ --exclude \".xgb_cache_*\" --only-show-errors", "echo \"Upload complete.\"", "echo \"=== All done at $(date -u) ===\"", "", "# Signal completion", "touch /tmp/xgb-training-DONE", "WRAPPER_EOF", "chmod +x /tmp/run-xgb-training.sh", "", "# Remove old completion signal", "rm -f /tmp/xgb-training-DONE", "", "# Launch detached (survives SSM timeout)", "nohup /tmp/run-xgb-training.sh &", "BGPID=$!", "echo \"Training launched as PID ${BGPID}\"", "echo \"Monitor: tail -f /tmp/xgb-training-v2.log\"", "echo \"Check completion: test -f /tmp/xgb-training-DONE && echo DONE || echo RUNNING\""]}