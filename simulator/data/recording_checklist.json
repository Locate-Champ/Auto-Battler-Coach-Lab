  "_instructions": {
    "setup": [
      "1. Set TFT graphics to Low/Very Low",
      "2. Enable Overwolf recording at 120 FPS",
      "3. Resolution: 1080p minimum"
    ],
    "recording_method": [
      "1. In PvE rounds (1-1 to 2-1), isolate one champion",
      "2. Position champion to attack from max range",
      "3. Record 5+ auto attacks per champion",
      "4. Note the stage/round for reference"
    ],
    "measurement": [
      "Use quick_measure.py to step through video",
      "Mark attack START (animation begins)",
      "Mark DAMAGE (HP bar drops or damage number)",
      "Tool auto-calculates windup time"
    ]
  },

