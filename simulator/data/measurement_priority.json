  "measurement_notes": {
    "setup": [
      "Use Practice Tool or controlled 1v1 fights",
      "Remove items to simplify timing",
      "Record at 120+ FPS (240 ideal)",
      "Use frame-by-frame playback"
    ],
    "anchors": [
      "Attack start: Unit begins attack animation",
      "Projectile spawn: Projectile becomes visible",
      "Damage frame: HP bar changes / damage number appears",
      "Attack end: Unit returns to idle or starts next attack"
    ],
    "formula": {
      "attack_windup_seconds": "(projectile_spawn_frame - attack_start_frame) / recording_fps",
      "attack_recovery_seconds": "(attack_end_frame - projectile_spawn_frame) / recording_fps",
      "total_attack_time": "1 / attack_speed (from stats)"
    }
  }
